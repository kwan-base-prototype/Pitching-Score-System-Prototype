# Copy to .env.local for local development, and set the same two variables in
# Vercel → Project → Settings → Environment Variables for the deploy.
#
# Only variables prefixed VITE_ reach the browser. Both of these are meant to:
# the anon key is a public, publishable key that grants nothing on its own, because
# every table is protected by row level security (supabase/migrations/).
#
# NEVER put the service-role key in here or anywhere else in this repo. It bypasses
# row level security completely and would give anyone who loads the page full
# read/write access to all data.

# Supabase project URL — Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# Supabase anon / publishable key — same page, "anon public"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Optional. The URL path the app is served from; defaults to / so routes read as
# /home and /hackathon-hub/h/:id/dashboard. Only set this to deploy under a
# subpath, and point the rewrite in vercel.json at the same prefix.
# BASE_PATH="/"
